# SQLite by default - no external DB needed for this standalone tool.
DATABASE_URL=sqlite:///./youtube_intel.db

# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=change_me
YOUTUBE_API_BASE_URL=https://www.googleapis.com/youtube/v3
YOUTUBE_DAILY_QUOTA_BUDGET=9000

SNAPSHOT_SYNC_ENABLED=false
SNAPSHOT_SYNC_INTERVAL_HOURS=6

# Optional: OAuth 2.0 Client ID (type "Web application") for the creator
# analytics feature. Add GOOGLE_OAUTH_REDIRECT_URI to its "Authorized
# redirect URIs" in Google Cloud Console.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8010/oauth/callback

ENVIRONMENT=development
DEBUG=false
CORS_ORIGINS=http://localhost:5175
REQUEST_TIMEOUT=30
